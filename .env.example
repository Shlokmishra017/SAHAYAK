# ==============================================================================
# SAHAYAK Monolithic Application Environment Configuration
# Minimal single-service configuration. All variables have safe defaults.
# ==============================================================================

# Operation mode: true for hackathon demo with synthetic cohort & seeded cases
DEMO_MODE=true

# Database: SQLite for zero-friction, reliable single-service deployment
DATABASE_URL=sqlite:///./sahayak.db

# Server port and host (dynamically configured by hosting platforms)
PORT=8000
HOST=0.0.0.0

# Security: JWT Signing Secret (must be 32+ characters)
JWT_SECRET=sahayak-production-monolith-deployment-secret-32-chars-min
JWT_ISSUER=sahayak-api
JWT_EXPIRY_MINUTES=60

# CORS: Set to "*" for public access (frontend and backend are same-origin)
CORS_ORIGINS=*

# Dual-Custody Break-Glass Protocol (Pre-configured demo credentials)
WELFARE_OFFICER_ID=WO_7742
WELFARE_OFFICER_PIN=9481
MEDICAL_OFFICER_ID=MO_3109
MEDICAL_OFFICER_PIN=6205
ADJUTANT_ID=ADJ_102
ADJUTANT_PIN=8821
BREAK_GLASS_TTL_MINUTES=15

# Demo Account Credentials (Default password for all 4 demo personas)
DEMO_ACCOUNT_PASSWORD=ServicePass@2026
