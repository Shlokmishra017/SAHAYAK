# Sahayak Configuration — SAFE EXAMPLE (no real secrets)
# Copy to .env and fill in deployment-specific values. Never commit .env.
DEMO_MODE=false
# Local dev (SQLite): sqlite:///./sahayak.db
# Production (PostgreSQL): postgresql+psycopg://sahayak:PASSWORD@db:5432/sahayak
DATABASE_URL=sqlite:///./sahayak.db
JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET
JWT_ISSUER=sahayak-api
JWT_EXPIRY_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Password for the four documented demo identities (dev/demo only).
# DEMO_ACCOUNT_PASSWORD=

# Dual-custodian authorized identifiers.
# PINs must be provided via environment / secret manager, never committed.
# Local dev only: create a local (untracked) .env with test values.
WELFARE_OFFICER_ID=WO_7742
WELFARE_OFFICER_PIN=
MEDICAL_OFFICER_ID=MO_3109
MEDICAL_OFFICER_PIN=
ADJUTANT_ID=ADJ_102
ADJUTANT_PIN=
BREAK_GLASS_TTL_MINUTES=15

# Alert e-mail delivery (optional deployment configuration).
# When unset, alerts are recorded internally with an explicit delivery note.
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_FROM=sahayak@localhost
# ALERT_SMTP_TO=welfare-officer@example.gov
